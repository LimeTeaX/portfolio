---
// src/components/CaseStudyLayout.astro
// Layout khusus untuk case study dengan margin notes
import BaseLayout from '../layouts/BaseLayout.astro';

export interface Props {
  title: string;
  date?: string;
  description?: string;
}

const { title, date, description } = Astro.props;
---

<BaseLayout title={title}>
  <article class="case-study">
    <header class="case-study__header">
      <div class="content-offset-2">
        <h1>{title}</h1>
        {date && <time class="case-study__date" datetime={date}>{date}</time>}
        {description && <p class="case-study__description">{description}</p>}
      </div>
    </header>

    <div class="case-study__body margin-note-container">
      <div class="margin-note-content">
        <slot name="content" />
      </div>
      <aside class="margin-note-sidebar">
        <slot name="notes" />
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study__header {
    margin-bottom: var(--space-2xl);
  }

  .case-study__date {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
  }

  .case-study__description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-top: var(--space-md);
    max-width: 70ch;
  }

  .case-study__body {
    margin-top: var(--space-xl);
  }
</style>