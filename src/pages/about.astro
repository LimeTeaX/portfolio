---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/about.css";
---

<BaseLayout title="About — Engineering Philosophy">
  <div class="section">
    <div class="content-offset-2">
      <h1>How I think about engineering</h1>
    </div>
  </div>

  <div class="section">
    <div class="content-main">
      <h2>What I optimize for</h2>
      <p>
        Good engineering is not about using the newest framework or having the
        most sophisticated architecture. It's about making tradeoffs explicit
        and reversible when possible.
      </p>
      <p>I prioritize:</p>
      <ul>
        <li>
          <strong>Clarity over cleverness</strong> — Code is read more than it's written
        </li>
        <li>
          <strong>Constraints as creative fuel</strong> — Limitations force better
          decisions
        </li>
        <li>
          <strong>Documentation as a feature</strong> — If it's not documented, it
          doesn't exist
        </li>
        <li>
          <strong>Failure as learning</strong> — Every outage is a documentation opportunity
        </li>
      </ul>

      <h2>Working style</h2>
      <p>
        I work best autonomously with clear constraints and regular check-ins on
        direction. I communicate asynchronously by default but appreciate
        synchronous whiteboarding for complex problems.
      </p>

      <hr />

      <h2>Contact</h2>
      <p>
        <a href="mailto:jacksonmajuoke@gmail.com">jacksonmajuoke@gmail.com</a>
      </p>
      <p class="text-secondary">No contact form. Just email.</p>

      <h2>Previously</h2>
      <ul class="compact-list">
        <li>Computer Science student at Universitas Sumatera Utara</li>
        <li>Freelance project: Not yet</li>
        <li>Built Portfolio with React, Astro, etc</li>
      </ul>
    </div>
  </div>
</BaseLayout>
