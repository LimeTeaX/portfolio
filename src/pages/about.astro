---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about.css';
---

<BaseLayout title="About — Engineering Philosophy">
  <div class="section">
    <div class="content-offset-2">
      <h1>How I think about engineering</h1>
    </div>
  </div>

  <div class="section">
    <div class="two-columns">
      <div class="content-main">
        <h2>What I optimize for</h2>
        <p>
          Good engineering is not about using the newest framework or having
          the most sophisticated architecture. It's about making tradeoffs
          explicit and reversible when possible.
        </p>
        <p>
          I prioritize:
        </p>
        <ul>
          <li><strong>Clarity over cleverness</strong> — Code is read more than it's written</li>
          <li><strong>Constraints as creative fuel</strong> — Limitations force better decisions</li>
          <li><strong>Documentation as a feature</strong> — If it's not documented, it doesn't exist</li>
          <li><strong>Failure as learning</strong> — Every outage is a documentation opportunity</li>
        </ul>

        <h2>Working style</h2>
        <p>
          I work best autonomously with clear constraints and regular check-ins
          on direction. I communicate asynchronously by default but appreciate
          synchronous whiteboarding for complex problems.
        </p>
      </div>

      <div>
        <h3>Contact</h3>
        <p>
          <a href="mailto:your.email@example.com">your.email@example.com</a>
        </p>
        <p class="text-secondary">
          No contact form. Just email.
        </p>

        <h3>Previously</h3>
        <ul class="compact-list">
          <li>Senior Engineer @ Company A</li>
          <li>Software Engineer @ Company B</li>
          <li>Started coding at age X</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>