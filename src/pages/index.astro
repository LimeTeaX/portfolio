---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import "../styles/home.css";

const caseStudies = await getCollection("caseStudies");
const sortedCaseStudies = caseStudies.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredCaseStudy = sortedCaseStudies[0];

const allNotes = await getCollection("notes");
const publishedNotes = allNotes.filter(
  (note: any) => note.data.published === true,
);
const recentNotes = publishedNotes.slice(0, 2);
---

<BaseLayout title="Jackson Maju Tambunan — Engineering Portfolio">
  <div class="hero-section">
    <div class="content-offset-2">
      <h1>
        Engineering is choosing which problems to solve<br />
        and which constraints to accept.
      </h1>
      <p class="lead">
        I build systems that fail informatively, scale predictably,<br />
        and document themselves where possible.
      </p>
    </div>
  </div>

  {
    featuredCaseStudy && (
      <div class="section">
        <div class="content-main">
          <h2>Featured case study</h2>
          <article class="featured-case-study">
            <h3>
              <a href={`/case-studies/${featuredCaseStudy.id}`}>
                {featuredCaseStudy.data.title}
              </a>
            </h3>
            <p>{featuredCaseStudy.data.description}</p>
            <div class="featured-meta">
              <span>{featuredCaseStudy.data.techStack.join(", ")}</span>
              <span class="separator">—</span>
              <span>{featuredCaseStudy.data.constraint}</span>
            </div>
            <a href={`/case-studies/${featuredCaseStudy.id}`} class="read-more">
              Read case study →
            </a>
          </article>
        </div>
      </div>
    )
  }

  <div class="section">
    <div class="two-columns">
      <div>
        <h3>Recent notes</h3>
        <ul class="note-list">
          {
            recentNotes.map((note: any) => (
              <li>
                <a href={`/notes/${note.id}`}>
                  <span class="note-title">{note.data.title}</span>
                  <span class="note-date">
                    {note.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>Currently</h3>
        <p>
          Computer Science student building thoughtful systems. <br />
          Looking for <a href="mailto:jacksonmajuoke@gmail.com"
            >internship or junior developer roles</a
          >.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .featured-case-study {
    background-color: rgba(0, 0, 0, 0.02);
    padding: var(--space-lg);
    margin-top: var(--space-md);
  }

  .featured-case-study h3 {
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .featured-case-study h3 a {
    text-decoration: none;
  }

  .featured-case-study h3 a:hover {
    color: var(--accent);
  }

  .featured-meta {
    margin: var(--space-md) 0;
    font-size: 0.875rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .separator {
    margin: 0 var(--space-xs);
  }

  .read-more {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  .note-list {
    list-style: none;
    padding: 0;
  }

  .note-list li {
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .note-list li a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    text-decoration: none;
  }

  .note-title {
    font-weight: 500;
  }

  .note-date {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>
