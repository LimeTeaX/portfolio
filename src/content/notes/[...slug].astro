---
// src/pages/notes/[...slug].astro
import { getCollection, type CollectionEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

type Props = {
  note: CollectionEntry<'notes'>;
};

const { note } = Astro.props as Props;
const { Content } = await render(note);
---

<BaseLayout title={`${note.data.title} — Notes`}>
  <article class="note">
    <div class="content-offset-2">
      <header class="note__header">
        <div class="note__meta">
          <time datetime={note.data.date.toISOString()}>
            {note.data.date.toLocaleDateString('en-US', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </time>
          <span>•</span>
          <span>{note.data.readingTime} min read</span>
        </div>
        
        <h1>{note.data.title}</h1>
        
        <div class="note__tags">
          {note.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <div class="note__content">
        <Content />
      </div>

      <footer class="note__footer">
        <hr />
        <p class="note__back">
          <a href="/notes">← Back to all notes</a>
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .note__header {
    margin-bottom: var(--space-2xl);
  }

  .note__meta {
    font-size: 0.875rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .note__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background-color: rgba(0, 0, 0, 0.03);
    padding: 0.25rem 0.5rem;
  }

  .note__content {
    margin-top: var(--space-xl);
  }

  .note__content :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .note__content :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .note__content :global(p) {
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .note__content :global(pre) {
    margin: var(--space-md) 0;
    padding: var(--space-md);
    background-color: #2d2d2d;
    border-radius: 4px;
    overflow-x: auto;
  }

  .note__content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .note__content :global(ul),
  .note__content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .note__content :global(li) {
    margin-bottom: var(--space-xs);
  }

  .note__footer {
    margin-top: var(--space-2xl);
  }

  .note__back a {
    color: var(--accent);
    text-decoration: none;
  }

  .note__back a:hover {
    text-decoration: underline;
  }
</style>